# Copy to .env.local and fill in. .env files are gitignored.

# Privy application id. This is a public identifier - it is shipped to the
# browser by design - but it is here so the app can be run against your own
# Privy application instead of the one it was developed against.
NEXT_PUBLIC_PRIVY_APP_ID=

# Coinbase Commerce, used by pages/api/checkout.js. Server-side only.
COINBASE_COMMERCE_API_KEY=
