# Copy to .env and fill in. .env is gitignored - never commit real values.

# Coinbase Developer Platform, used by AgentKit for the agent's wallet.
# CDP_API_KEY_PRIVATE_KEY is a private key: treat it like one.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# OpenAI, used by the legal consultant, compliance officer and contract drafter.
OPENAI_API_KEY=

# Chain the agent transacts on.
NETWORK_ID=base-sepolia
BASE_SEPOLIA_RPC=https://sepolia.base.org

PORT=5001
